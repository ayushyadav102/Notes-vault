{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in the NotesVault archive without required school/grade fields.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "password": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "maxLength": 50 },
        "grade": { "type": "number", "minimum": 5, "maximum": 12 },
        "schoolName": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "timestamp" },
        "lastLoginAt": { "type": "timestamp" }
      },
      "required": ["id", "studentId", "name", "password", "role"]
    },
    "Note": {
      "title": "Note",
      "description": "A study note uploaded by a student or community member.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 100 },
        "subject": { "type": "string", "maxLength": 50 },
        "department": { "type": "string", "maxLength": 50 },
        "schoolName": { "type": "string", "maxLength": 100 },
        "schoolCode": { "type": "string", "maxLength": 50 },
        "grade": { "type": "number", "minimum": 5, "maximum": 12 },
        "pages": { "type": "number", "minimum": 1 },
        "sizeMB": { "type": "number", "minimum": 0 },
        "rating": { "type": "number", "minimum": 0, "maximum": 5 },
        "reviews": { "type": "number", "minimum": 0 },
        "author": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "maxLength": 50 },
            "initials": { "type": "string", "maxLength": 3 },
            "badge": { "type": "string", "maxLength": 50 },
            "badgeStyle": { "type": "string" }
          },
          "required": ["name", "initials", "badge"]
        },
        "thumbnailUrl": { "type": "string", "maxLength": 500 },
        "isPdf": { "type": "boolean" },
        "fileName": { "type": "string", "maxLength": 200 },
        "fileType": { "type": "string", "maxLength": 100 },
        "fileData": { "type": "string", "maxLength": 900000 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["title", "subject", "grade", "ownerId", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of registered user accounts."
    },
    "notes/{noteId}": {
      "schema": { "$ref": "#/entities/Note" },
      "description": "Collection of all study notes uploaded by students."
    }
  }
}
