rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidNote(data) {
      return data.keys().hasAll(['title', 'subject', 'grade', 'ownerId', 'createdAt', 'author', 'pages', 'sizeMB', 'rating', 'reviews', 'department', 'thumbnailUrl', 'isPdf'])
          && data.title is string && data.title.size() <= 100
          && data.subject is string && data.subject.size() <= 50
          && data.department is string && data.department.size() <= 50
          && data.grade is number && data.grade >= 5 && data.grade <= 12
          && data.pages is number && data.pages >= 1
          && data.sizeMB is number && data.sizeMB >= 0
          && data.rating is number && data.rating >= 0 && data.rating <= 5
          && data.reviews is number && data.reviews >= 0
          && data.author is map
          && data.author.keys().hasAll(['name', 'initials', 'badge'])
          && data.author.name is string && data.author.name.size() <= 50
          && data.author.initials is string && data.author.initials.size() <= 3
          && data.author.badge is string && data.author.badge.size() <= 50
          && data.thumbnailUrl is string && data.thumbnailUrl.size() <= 500
          && data.isPdf is bool
          && data.ownerId is string && data.ownerId.size() <= 128
          && data.ownerId == request.auth.uid
          && data.createdAt == request.time;
    }

    match /notes/{noteId} {
      // Anyone can read and browse notes
      allow read: if true;
      
      // Only authenticated users can create notes they own
      allow create: if isSignedIn() && isValidId(noteId) && isValidNote(incoming()) && incoming().keys().size() == 13;
      
      allow update: if false;
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }
  }
}
